# Variáveis de ambiente da Camada de Mielina (Fases 3–4)
#
# Copie para `.env.local` (NUNCA commite `.env` com segredos) e configure na
# Vercel em Project Settings → Environment Variables. Segredos ficam apenas no
# servidor: nada é exposto ao navegador além do cookie de sessão cifrado.
#
# Falha fechada: rota que precisa de variável ausente responde 503.

# ---------------------------------------------------------------- OAuth GitHub App
# Client ID da GitHub App instalada em ironidesflj/noos-hub (público).
MIELINA_GITHUB_CLIENT_ID=
# Client secret da GitHub App (NUNCA commitar; rotacione se vazar).
MIELINA_GITHUB_CLIENT_SECRET=
# Origem pública canônica do hub. Usada no redirect_uri, na validação de Origin
# e no cookie Secure. Ex.: https://noos.study
MIELINA_BASE_URL=https://noos.study
# Origens extras aceitas em POST (CSV), útil para previews da Vercel/dev local.
# Ex.: https://noos-hub-git-minha-branch.vercel.app,http://localhost:3000
MIELINA_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- sessão
# Segredo da cifra AES-256-GCM dos cookies de sessão/estado OAuth.
# Mínimo 16 caracteres; gere com: openssl rand -base64 48
MIELINA_SESSION_SECRET=
# Apenas desenvolvimento local em http://localhost:3000 (nunca em produção).
# Com "1", os cookies deixam de levar o atributo Secure.
MIELINA_INSECURE_COOKIES=0

# ---------------------------------------------------------------- GitHub servidor
# Token de serviço (GitHub App installation token ou fine-grained PAT) com:
#   - Discussions: read/write      (ler/criar comments quando necessário)
#   - Contents: read/write         (README de main e repository_dispatch)
#   - Metadata: read
MIELINA_GITHUB_TOKEN=
# Token específico para repository_dispatch (fallback: MIELINA_GITHUB_TOKEN).
# Precisa de Contents: read/write (ou "Repository contents: read and write").
MIELINA_DISPATCH_TOKEN=
# Timeout (ms) de cada chamada ao GitHub feita pelas Functions. Default 10000;
# inteiro positivo (teto de segurança 60000). Ao estourar, a rota responde
# 504 GITHUB_TIMEOUT e o cliente do apoio reconcilia o contador via GET.
# Valores bem pequenos só fazem sentido em teste.
MIELINA_GITHUB_TIMEOUT_MS=10000

# Repositório canônico (owner/name). Default: ironidesflj/noos-hub.
MIELINA_REPO=ironidesflj/noos-hub
# Node ID da categoria Q&A usada para criar a Discussion canônica da questão.
# Obtenha com a query GraphQL: repository { discussionCategories(first:20){...} }
MIELINA_DISCUSSION_CATEGORY_ID=

# ---------------------------------------------------------------- dados publicados
# Base do raw.githubusercontent usado para ler discussao/*.json e manifestos/*.
# Default: https://raw.githubusercontent.com (deixe vazio em produção).
MIELINA_RAW_BASE=

# ---------------------------------------------------------------- workflow (GitHub Actions)
# GITHUB_TOKEN e GITHUB_REPOSITORY são injetados automaticamente pelo Actions;
# não precisam ser configurados manualmente. O workflow usa:
#   permissions: contents: write, discussions: read
# Nenhuma variável deste arquivo é necessária para rodar `npm run build`/`qa`.
