{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "buildCommand": "node build/gera-questoes.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/q/:id", "destination": "/api/q?p=/q/:id" },
    { "source": "/pt/q/:id", "destination": "/api/q?p=/pt/q/:id" },
    { "source": "/en/q/:id", "destination": "/api/q?p=/en/q/:id" },
    { "source": "/q/:id/", "destination": "/api/q?p=/q/:id/" },
    { "source": "/pt/q/:id/", "destination": "/api/q?p=/pt/q/:id/" },
    { "source": "/en/q/:id/", "destination": "/api/q?p=/en/q/:id/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
